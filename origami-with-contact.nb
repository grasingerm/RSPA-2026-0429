                 SuperscriptBox[
                  RowBox[{"Sin", "[", "\[Alpha]", "]"}], "2"]}]}], ")"}]}], "-", 
             RowBox[{"2", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Alpha]"}], "]"}], " ", 
              RowBox[{"Sin", "[", 
               FractionBox["\[Phi]1", "2"], "]"}], " ", 
