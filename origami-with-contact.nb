Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TranslateOrigami", "[", 
    RowBox[{"origami_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"j", ",", "origamiCopy"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"origamiCopy", "=", "origami"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", 
        RowBox[{"j", "\[LessEqual]", 
         RowBox[{"Length", "[", "origamiCopy", "]"}]}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"origamiCopy", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "=", 
          RowBox[{"transX", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"origamiCopy", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "c"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "origamiCopy", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
