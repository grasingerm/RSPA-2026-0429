             RowBox[{"[", 
              RowBox[{"Length", "[", "\[Rho]Idxs", "]"}], "]"}], "]"}], "]"}],
            "]"}]}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
