ff47345d34d8"],

Cell[TextData[{
 "In this section, we consider an origami vertex with 6 creases which has a \
reflection symmetry about ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", "TI"], "^"], "2"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "1", ",", "0"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat e_2 = (0, 1, 0)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3ed122a-cb32-476b-a62c-dcf3a320ea5c"],
 ". The angles between pairs of adjacent creases in the flat state are called \
sector angles. The sector angle between creases ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a68f9176-e29b-4ae5-a7b2-48a2358954be"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "+", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "i+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "032fcc13-8e92-453a-908b-7f9ee85e7f2e"],
 " is denoted by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Alpha]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d256678d-61b2-4cb3-bcf2-d1f457aff35b"],
 ". The degree 6 vertices considered in this section are parameterized by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Alpha]", "1"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "febf0246-cd79-4173-a012-273f27619675"],
 " such that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Alpha]", "3"], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", "4"], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", "6"], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", "1"], ",", 
         SubscriptBox["\[Alpha]", "2"], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", "4"], "\[LongEqual]", "\[Pi]", "-", "2", 
         SubscriptBox["\[Alpha]", "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\alpha_3=\\alpha_4=\\alpha_6=\\alpha_1, \
\\alpha_2=\\alpha_4=\\pi-2\\alpha_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "140439ff-be7d-40de-b5af-235c5f064d16"],
 ". The crease unit vectors and an example vertex (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Alpha]", "1"], "\[LongEqual]", "\[Pi]", "/", "6"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\alpha_1=\\pi/6", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e79c382d-5e4f-4a95-a26d-d08021d66390"],
 ") are given below."
}], "Text",
 CellChangeTimes->{{3.934638964194292*^9, 3.934639144066597*^9}, {
  3.934639202600686*^9, 3.9346392310067997`*^9}, {3.9346392855829587`*^9, 
