Cell[TextData[{
 "We are interested in the ways in which these origami structures can fold; \
however, solving the compatibility condition (i.e. loop-closure condition) is \
difficult, in general. Here we aim to leverage the symmetry of the flat \
configuration in order to formulate and solve reduced order compatibility \
conditions. The principal innovation here is to recognize that the choice of \
\[OpenCurlyDoubleQuote]frame\[CloseCurlyDoubleQuote] where face 1 is fixed \
was arbitrary. Instead, consider rotating face 1 via ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], "(", 
         RowBox[{
           SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "Q_{b_1}(\\phi_1 / 2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "58ef44a3-172d-41d4-8bdc-abed3c541e6d"],
 " and face 6 via ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], "(", 
         RowBox[{"-", 
           SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "Q_{b_1}(-\\phi_1 / 2)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d514f8f4-879d-4a20-83d2-addc2b5f8d30"],
 ". Then crease 1 has fold angle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "1"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6ff2ece-0868-456f-a097-daac9eee0196"],
 " as desired, and, importantly, face 6 is a ",
 StyleBox["reflection of face 1",
  FontSlant->"Italic"],
 " about the plane normal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", "TI"], "^"], "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat e_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "298f26c5-6141-4516-ab74-8b59e02d91cd"],
 ". Proceeding in this way, face 2 is mapped via ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "2"]], 
         RowBox[{"(", 
           SubscriptBox["\[Phi]", "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Q_{b_1}(\\phi_1/2) Q_{b_2}(\\phi_2)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7ba07b1-9a7b-44b4-8911-677c6f2eada1"],
 " and face 3 via ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "2"]], 
         RowBox[{"(", 
           SubscriptBox["\[Phi]", "2"], ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "3"]], 
         RowBox[{"(", 
           SubscriptBox["\[Phi]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "Q_{b_1}(\\phi_1/2) Q_{b_2}(\\phi_2)Q_{b_3}(\\phi_3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e933a51e-3e1c-42e9-a4e4-4f4bac0cd54b"],
 ". Now, if crease 4, which is adjacent to face 3, is mapped into the plane \
normal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", "TI"], "^"], "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat e_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1780ddd-727f-4940-a3a2-74d74d499eef"],
 ", then we can obtain a folded structure which is both compatible and ",
 StyleBox["has the same symmetry as the flat state",
  FontSlant->"Italic"],
 " by simply assigning the remaining fold angles as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Phi]", "5"], "\[LongEqual]", 
         SubscriptBox["\[Phi]", "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi_5=\\phi_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce5ee5cb-0478-4a6c-8259-6db3ee8c6ba8"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Phi]", "6"], "\[LongEqual]", 
         SubscriptBox["\[Phi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi_6=\\phi_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41f32384-900a-4acf-8c6e-606655a4efae"],
 ". Thus, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               StyleBox["b", "TI"], "1"]], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], 
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               StyleBox["b", "TI"], "2"]], 
             RowBox[{"(", 
               SubscriptBox["\[Phi]", "2"], ")"}], 
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               StyleBox["b", "TI"], "3"]], 
             RowBox[{"(", 
               SubscriptBox["\[Phi]", "3"], ")"}], 
             SubscriptBox[
              StyleBox["b", "TI"], "3"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", "TI"], "^"], "2"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(Q_{b_1}(\\phi_1 / 2)Q_{b_2}(\\phi_2)Q_{b_3}(\\phi_3)b_3)\\cdot \\hat \
e_2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09f163a5-6cf7-4859-aa57-45786a0db26e"],
 " represents a reduced-order compatibility condition for the degree 6 \
vertices of interest [7]. This kind of reduction can be done, in general, for \
origami vertices with a reflection symmetry where a pair of collinear creases \
lie within the plane of symmetry. In general, the number of unknowns is \
reduced from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "-", "3"}], TraditionalForm], "errors" -> {}, 
     "input" -> "N-3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f499a9f4-69d0-44d0-a591-c21e8e93e1ad"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "/", "2", "-", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "N/2-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd7269be-300e-4d28-a396-e7db92d26ae5"],
 " [7], and one only needs to solve a single nonlinear equation as opposed to \
a system of 3 nonlinear equations."
}], "Text",
 CellChangeTimes->{
  3.934643341638432*^9, {3.934643589618142*^9, 3.9346436998282967`*^9}, {
   3.9346437326628246`*^9, 3.934643898323888*^9}, {3.9346439365299206`*^9, 
   3.93464394190217*^9}, 3.934643986817322*^9, {3.934644041816108*^9, 
   3.9346440514500847`*^9}, 3.9346440910640554`*^9, {3.9346441235403876`*^9, 
   3.9346441444982224`*^9}, {3.9348903251824784`*^9, 3.934890385748324*^9}, {
   3.9348904445625076`*^9, 
   3.9348905153249884`*^9}},ExpressionUUID->"a0945b91-7ef4-4c2f-b3ba-\
718718072295"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"y64", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Q", "[", 
     RowBox[{
      RowBox[{"x6s", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"\[Phi]1", "/", "2"}]}], "]"}], ".", 
    RowBox[{"Q", "[", 
     RowBox[{
      RowBox[{"x6s", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", "\[Phi]2"}], "]"}], ".", 
    RowBox[{"Q", "[", 
     RowBox[{
      RowBox[{"x6s", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", "\[Phi]3"}], "]"}], ".", 
    RowBox[{"x6s", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "crease", " ", "unit", " ", "vector", " ", "4", " ", "in", " ", "the", " ",
     "deformed", " ", "configuration"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.828110230354473*^9, 3.8281102589702883`*^9}, {
  3.9346255346970544`*^9, 3.9346255418006096`*^9}, {3.9346255996910973`*^9, 
  3.9346256004408627`*^9}, {3.9346673417370815`*^9, 3.934667341968942*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"ba7a1ff5-eb7c-4cc7-9b0f-0b287b671936"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"]}], " ", 
          RowBox[{"(", 
           RowBox[{
