  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "94366e41-6d9e-4dee-9e43-5e24fc7b2eec"],
 ". One can solve for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c58fceba-0800-4d55-9c67-fb5b5f3edcd3"],
 " by first mapping ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["b", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "b_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d08b0a44-2bac-47f9-ab99-12f24e1d4ab2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["b", "TI"], "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "b_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "671db39d-8a06-4bcd-9d88-d78fcab97de6"],
 " to the deformed configuration. Then a vector normal to face 3 is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], "3"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["b", "TI"], "3"], "\[Cross]", 
         SubscriptBox[
          StyleBox["b", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v_3=b_3 \\times b_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb1b333c-db64-43e4-aaf3-bd1f43accf86"],
 " and we can determine ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0e92b81-ed65-4cc6-bfe8-44e9386125e2"],
 " by taking the dot product of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["v", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "v_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0097a9cc-1f5e-4700-a4bb-f1ee664110cf"],
 " with its reflection about the plane normal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", "TI"], "^"], "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat e_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe84d884-24bd-446e-bcbb-a5e8fbf4f952"],
 " [7]."
}], "Text",
