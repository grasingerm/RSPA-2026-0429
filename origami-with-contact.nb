Cell[CellGroupData[{

Cell["Eight fold, D4 (more symmetry, less DOF)", "Subtitle",
 CellChangeTimes->{{3.829381737284037*^9, 3.829381739732753*^9}, {
  3.830864656224015*^9, 3.8308646583426523`*^9}, {3.924185288606187*^9, 
  3.9241852927843266`*^9}},ExpressionUUID->"e014d535-fb10-4f81-bec5-\
13d55a07441f"],

Cell[TextData[{
 "In this section, we consider degree 8 vertices with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "D_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2df7f60-e1ed-4ac8-869f-5476153b9c59"],
 " symmetry; that is, with reflection and rotational symmetries. The \
arguments below are similar to the 6 fold case; however, the principal \
difference is with the choice of frame (i.e. the convention for the \
deformation map up to full rigid body rotations and translations). Here, \
inspired by past work on waterbomb origami [10], we imagine the center vertex \
as either being pushed up or down during folding. In this case, the \
deformation map becomes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           OverscriptBox[
            StyleBox["e", "TI"], "^"], "2"]], 
         RowBox[{"(", "\[Upsilon]", ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "Q_{\\hat e_2}(\\upsilon)Q_{b_1}(\\phi_1 / 2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a5b1733-8e6e-4f49-967e-0135730f4a9d"],
 " for face 1, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           OverscriptBox[
            StyleBox["e", "TI"], "^"], "2"]], 
         RowBox[{"(", "\[Upsilon]", ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "1"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          SubscriptBox[
           StyleBox["b", "TI"], "2"]], 
         RowBox[{"(", 
           SubscriptBox["\[Phi]", "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "Q_{\\hat e_2}(\\upsilon)Q_{b_1}(\\phi_1 / 2)Q_{b_2}(\\phi_2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "836ff319-7d22-419a-94ae-4263b7ef8dc3"],
 " for face 2, etc. (see [7]). Then if one folds faces 1 and 2 such that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["e", "TI"], "^"], "2"]], 
             RowBox[{"(", "\[Upsilon]", ")"}], 
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               StyleBox["b", "TI"], "1"]], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["\[Phi]", "1"], "/", "2"}], ")"}], 
             SubscriptBox[
              StyleBox["Q", "TI"], 
              SubscriptBox[
               StyleBox["b", "TI"], "2"]], 
             RowBox[{"(", 
               SubscriptBox["\[Phi]", "2"], ")"}], 
             SubscriptBox[
              StyleBox["b", "TI"], "3"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", "TI"], "^"], "1"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(Q_{\\hat e_2}(\\upsilon)Q_{b_1}(\\phi_1 / 2)Q_{b_2}(\\phi_2)b_3)\\cdot \
\\hat e_1 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa9be3f8-f368-4f69-948e-1c4d17a3ebfa"],
 ", a compatibly folded vertex can be formed by first making a copy of faces \
1 and 2 by reflecting it about the plane normal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", "TI"], "^"], "1"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat e_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "282529b2-64b2-44ba-aadc-c64fc15040d5"],
 " and then copying faces 1-4 by reflecting them about the plane normal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", "TI"], "^"], "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat e_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a1dac8d0-2112-43d5-b3eb-23edb887311a"],
 ". For more detail, see [7]."
}], "Text",
 CellChangeTimes->{{3.934752183543523*^9, 3.934752398871348*^9}, {
  3.9347524678395324`*^9, 3.934752471249647*^9}, {3.934752508730826*^9, 
  3.9347525668439183`*^9}, {3.9347526229073596`*^9, 3.934752655330876*^9}, {
  3.93475269090394*^9, 3.934752751944227*^9}, {3.9347528130619955`*^9, 
  3.9347529384131517`*^9}},ExpressionUUID->"6d73fef1-c21c-4870-b4f9-\
b108e2dc85e7"],

