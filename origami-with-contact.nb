Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Phi]1", "\[Rule]", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{
