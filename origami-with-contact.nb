Cell[TextData[{
 "The above solution describes some ways of folding degree 6 vertices with a \
reflection symmetry such that it ",
 StyleBox["satisfies compatibility",
  FontSlant->"Italic"],
 ",",
 " and its folded state also has a reflection symmetry. However, there are \
solutions for folding the vertex without tears that involve the origami \
contacting and even passing through itself. These solutions are nonphysical \
since a real origami cannot intersect itself. Thus, we also check each folded \
state to see if it involves self intersection. Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27be7815-be91-4314-978a-6098b8a6a8d8"],
 " denote the crease vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "b_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb4ce535-987b-486e-9ade-5f001a3966e9"],
 " mapped into the folded configuration. If any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", "TI"], "^"], "2"], "<", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c_i \\cdot \\hat e_2 < 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "696b8c80-09de-4ee8-b579-668940211ad1"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "...", ",", "4"}], 
       TraditionalForm], "errors" -> {}, "input" -> "i=1, ..., 4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8be94c97-40a0-4222-a36c-cd3ba3f8c624"],
 ", then, by symmetry, self-contact has occurred. We must also check each \
edge of the first 3 faces to see if it has intersected any other face. One \
can determine if a line and triangle intersect by appealing to the signed \
volume of a tetrahedron: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["y", "TI"], "1"], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], "2"], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], "3"], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], "4"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", "6"], 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["y", "TI"], "2"], "-", 
                 SubscriptBox[
                  StyleBox["y", "TI"], "1"]}], ")"}], "\[Cross]", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["y", "TI"], "3"], "-", 
                 SubscriptBox[
                  StyleBox["y", "TI"], "1"]}], ")"}]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["y", "TI"], "4"], "-", 
             SubscriptBox[
              StyleBox["y", "TI"], "1"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "V(y_1,y_2,y_3,y_4)=\\frac{1}{6}((y_2-y_1)\\times(y_3-y_1))\\cdot(y_4-y_\
1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9b34f11-18a3-4dee-b834-9bf569915347"],
 ". Now let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["q", "TI"], "1"], TraditionalForm], "errors" -> {}, "input" -> 
     "q_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6577c3e-bef7-4cc5-a661-5b7f0508b702"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["q", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "q_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8db99da0-7e1e-4947-b715-6a0a7f4ce795"],
 " denote the end points of an edge, and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_1, p_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8015a723-4a7c-429d-ad46-6b63b56cfbcc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "p_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4726dcc-3ad6-4d80-8680-2a983fef60a2"],
 " denote the vertices of a triangle. The two intersect if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["sgn", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "(", 
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "3"]}], ")"}], ")"}], "\[NotEqual]", 
         StyleBox["sgn", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "(", 
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "3"]}], ")"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\mathrm{sgn}(V(q_1,p_1,p_2,p_3))\\neq \
\\mathrm{sgn}(V(q_2,p_1,p_2,p_3))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a955bd04-0b8b-46f1-996e-bbceaaac65a5"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["sgn", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "(", 
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["q", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "2"]}], ")"}], ")"}], "\[LongEqual]", 
         StyleBox["sgn", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "(", 
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["q", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "3"]}], ")"}], ")"}], "\[LongEqual]", 
         StyleBox["sgn", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "(", 
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], "1"], ",", 
               SubscriptBox[
                StyleBox["q", "TI"], "2"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "3"], ",", 
               SubscriptBox[
                StyleBox["p", "TI"], "1"]}], ")"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\mathrm{sgn}(V(q_1,q_2,p_1,p_2))=\\mathrm{sgn}(V(q_1,q_2,p_2,p_3))=\\\
mathrm{sgn}(V(q_1,q_2,p_3,p_1))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb59b424-cf4f-40cd-83a9-73eb51ef0c9f"],
 " [9]."
}], "Text",
 CellChangeTimes->{{3.9347504131424685`*^9, 3.934750745143219*^9}, {
  3.934750883042012*^9, 3.9347509852574773`*^9}, {3.9347510486633296`*^9, 
  3.934751150498375*^9}, {3.93475124181229*^9, 3.934751318138522*^9}, {
  3.9347513917007246`*^9, 3.934751396820689*^9}, {3.9347514786483974`*^9, 
  3.9347514827645903`*^9}, {3.9348905776632414`*^9, 3.934890599804019*^9}, {
  3.9348906344317656`*^9, 
  3.934890634576105*^9}},ExpressionUUID->"f6387eb0-12ac-4ab2-877c-\
3e61eae35720"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SignedVolume", "[", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      FractionBox["1", "6"], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "a"}], ")"}], "\[Cross]", 
         RowBox[{"(", 
          RowBox[{"c", "-", "a"}], ")"}]}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"d", "-", "a"}], ")"}]}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "compute", " ", "the", " ", "signed", " ", "volume", " ", "of", " ", "a", 
     " ", "tetrahedron"}], ";", " ", 
    RowBox[{
    "used", " ", "for", " ", "detecting", " ", "contact", " ", "between", " ", 
     RowBox[{"(", "triangular", ")"}], " ", "faces"}]}], " ", 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.910863711427041*^9, 3.9108637631390295`*^9}, {
  3.934625674201007*^9, 3.9346257186037264`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"2abad728-8e60-4442-b6ff-eb74970b96f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EdgeIntersectTriangle", "[", 
     RowBox[{"e_", ",", "t_", ",", 
      RowBox[{"\[Epsilon]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"test1", ",", "test2"}], "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "detects", " ", "if", " ", "an", " ", "edge", " ", "is", " ", 
        "intersecting", " ", "a", " ", "triangle"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"test1", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SignedVolume", "[", 
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "*", 
           RowBox[{"SignedVolume", "[", 
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"t", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ")"}], "<", 
         RowBox[{"-", "\[Epsilon]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"test2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SignedVolume", "[", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"e", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "*", 
             RowBox[{"SignedVolume", "[", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"e", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ")"}], ">", 
           "\[Epsilon]"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SignedVolume", "[", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"e", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "*", 
             RowBox[{"SignedVolume", "[", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"e", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"t", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ",", 
