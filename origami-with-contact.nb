Cell[TextData[{
 "Now with functions in hand to compute the fold angles of a degree 6 vertex, \
to determine whether it is self-intersecting, and to visualize a folded \
origami vertex, we create an interactive degree 6 vertex. The structure folds \
as a function of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bb61cdd-0dc5-4797-8cbf-b687babf24c2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c8bf301-144b-48e8-98ef-2b8f5c1edf89"],
 ". A red, tinted box around the origami denotes that self contact was \
detected."
}], "Text",
 CellChangeTimes->{{3.934751957160383*^9, 
  3.934752126852741*^9}},ExpressionUUID->"0f0fdfd3-564f-458a-9325-\
442953b1517a"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
    "visualizes", " ", "the", " ", "folding", " ", "of", " ", "degree", " ", 
     "6", " ", "vertices"}], ";", " ", 
    RowBox[{
    "\[Alpha]", " ", "is", " ", "the", " ", "first", " ", "sector", " ", 
     "angle"}]}], ",", " ", 
   RowBox[{
   "\[Phi]2", " ", "is", " ", "the", " ", "second", " ", "fold", " ", 
    "angle"}], ",", " ", 
   RowBox[{
    RowBox[{
    "and", " ", "\[Phi]3", " ", "is", " ", "the", " ", "third", " ", "fole", " ",
      "angle"}], ";", " ", 
    RowBox[{"red", "-", 
     RowBox[{
     "tinted", " ", "box", " ", "denotes", " ", "that", " ", "self", " ", 
      "contact", " ", "was", " ", "detected"}]}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9346261381549*^9, 3.934626187134289*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"bfc7e975-13d2-4acd-8ace-a7862a43c911"],

