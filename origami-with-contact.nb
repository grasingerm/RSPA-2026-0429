              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "<", "1"}], "&&", 
          RowBox[{"0", "<", 
           RowBox[{"(", 
            RowBox[{"s", "/.", 
             RowBox[{"tsSoln", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "<", "1"}]}], ",", 
         "False"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
