             RowBox[{
              RowBox[{"Cos", "[", 
               FractionBox["\[Phi]1", "2"], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Cos", "[", "\[Alpha]", "]"}], "+", 
