  RowBox[{
   RowBox[{"LineIntersectLine", "[", 
    RowBox[{"l1_", ",", "l2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "tsSoln"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "t"}], ")"}], "*", 
         RowBox[{"l1", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "+", 
        RowBox[{"t", "*", 
         RowBox[{"l1", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "s"}], ")"}], "*", 
         RowBox[{"l2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "+", 
        RowBox[{"s", "*", 
         RowBox[{"l2", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", 
       RowBox[{"tsSoln", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"x", "==", "y"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "s"}], "}"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "tsSoln", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"0", "<", 
           RowBox[{"(", 
