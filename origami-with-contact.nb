Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Solution6WithLeastError", "[", 
    RowBox[{"\[Phi]62v_", ",", "\[Phi]63v_", ",", "\[Alpha]v_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Phi]61v", ",", "\[Phi]6sL", ",", "soln6Idx", ",", "minError", ",", 
       "minErrorIdx", ",", "err"}], "}"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "finds", " ", "solution", " ", "to", " ", "degree", " ", "6", " ", 
       "vertex", " ", "that", " ", "has", " ", "the", " ", "least", " ", 
       "error"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"minError", "=", "\[Infinity]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"minErrorIdx", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"soln6Idx", "=", "1"}], ",", 
        RowBox[{"soln6Idx", "\[LessEqual]", 
         RowBox[{"Length", "[", "soln6Simplest", "]"}]}], ",", 
        RowBox[{"soln6Idx", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Phi]61v", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Phi]1", "/.", 
              RowBox[{"soln6Simplest", "[", 
               RowBox[{"[", "soln6Idx", "]"}], "]"}]}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]v"}], ",", 
              RowBox[{"\[Phi]2", "\[Rule]", "\[Phi]62v"}], ",", 
              RowBox[{"\[Phi]3", "\[Rule]", "\[Phi]63v"}]}], "}"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"\[Phi]6sL", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"{", 
              RowBox[{"\[Phi]61v", ",", "\[Phi]62v", ",", "\[Phi]63v", ",", 
               RowBox[{"\[Phi]64", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Phi]1", "\[Rule]", "\[Phi]61v"}], ",", 
                  RowBox[{"\[Phi]2", "\[Rule]", "\[Phi]62v"}], ",", 
                  RowBox[{"\[Phi]3", "\[Rule]", "\[Phi]63v"}], ",", 
                  RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]v"}]}], "}"}]}], ",",
                "\[Phi]63v", ",", "\[Phi]62v"}], "}"}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]v"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"err", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Phi]61v", "===", "Indeterminate"}], "||", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"Im", "[", "\[Phi]61v", "]"}], "]"}], ">", 
              SuperscriptBox["10", 
               RowBox[{"-", "10"}]]}]}], ",", "Infinity", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"vertexLoopMap", "[", 
               RowBox[{
                RowBox[{"x6s", "/.", 
                 RowBox[{"{", 
                  RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]v"}], "}"}]}], ",", 
                "\[Phi]6sL"}], "]"}], "-", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"err", "<", "minError"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"minError", "=", "err"}], ";", "\[IndentingNewLine]", 
            RowBox[{"minErrorIdx", "=", "soln6Idx"}]}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"minErrorIdx", ",", "minError"}], "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solution6WithLeastError2", "[", 
    RowBox[{"\[Phi]62v_", ",", "\[Phi]63v_", ",", "\[Alpha]v_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Phi]61v", ",", "\[Phi]6sL", ",", "soln6Idx", ",", "minError", ",", 
       "minErrorIdx", ",", "err"}], "}"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"another", " ", 
       RowBox[{"version", "?"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"minError", "=", "\[Infinity]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"minErrorIdx", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
