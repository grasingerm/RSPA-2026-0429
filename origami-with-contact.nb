       "find", " ", "the", " ", "1", " ", "with", " ", "the", " ", "least", " ",
         "error"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"minError", "=", "\[Infinity]"}], ";", "\[IndentingNewLine]", 
