Cell[CellGroupData[{

Cell["Origami constructor", "Title",
 CellChangeTimes->{{3.8164341395471287`*^9, 
  3.816434179253996*^9}},ExpressionUUID->"54dfee3a-031d-4f54-a5ab-\
e92050409757"],

Cell["\<\
  \[Theta]v                        -   The polar angle (i.e. angle with \
respect to the polar axis) of the ' main' crease. Range is from 0 to \[Pi] (0 \
is \[OpenCurlyDoubleQuote]popped-up\[CloseCurlyDoubleQuote] and \[Pi] is \
\[OpenCurlyDoubleQuote]popped-down\[CloseCurlyDoubleQuote]).
 rawSolnIdxs    -    Vector of folding branch IDs. There are two folding \
branches for each flap so this can take values 1 or 2. The length of this \
vector determines the number of folds.
                                    Specifically, the number of folds is \
twice the length of this vector.\
\>", "Text",
 CellChangeTimes->{{3.816434206893215*^9, 3.816434330787984*^9}, {
  3.816434375775507*^9, 3.8164344271120663`*^9}, {3.8164357410097523`*^9, 
  3.8164357495346947`*^9}, {3.8164377665659924`*^9, 3.816437772068825*^9}, {
  3.8164378257793007`*^9, 
  3.8164378919004707`*^9}},ExpressionUUID->"9b06cd0c-f675-4abe-aec5-\
5b94174b050f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ASymmWaterbomb", "[", 
    RowBox[{"\[Theta]v_", ",", "rawSolnIdxs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "origami", ",", "\[Alpha]", ",", "E1", ",", "e1", ",", "r", ",", 
       "refTriA", ",", "nvec", ",", "ret", ",", "i", ",", "nl", ",", "refTri",
        ",", "QFlap", ",", "eaxis", ",", "tri", ",", "\[Rho]v", ",", 
       "solnIdxs"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"solnIdxs", "=", 
       RowBox[{"rawSolnIdxs", "+", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[Theta]v", "\[GreaterEqual]", 
             RowBox[{"\[Pi]", "/", "2"}]}], ",", "2", ",", "0"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "rawSolnIdxs", "]"}]}], "}"}]}], "]"}]}]}],
       ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Shift", " ", "indices", " ", "if", " ", "we", " ", "are", " ", 
        "below", " ", "the", " ", "flat", " ", "state"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"nl", "=", 
       RowBox[{"2", "*", 
        RowBox[{"Length", "[", "solnIdxs", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"2", "*", 
        RowBox[{"\[Pi]", "/", "nl"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"E1", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"refTriA", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "E1", ",", "r"}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"e1", "=", 
       RowBox[{
        RowBox[{"Q", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", "\[Theta]v"}]}], "]"}], ".", 
        "E1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ret", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "[", "solnIdxs", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Rho]v", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Rho]s", "[", 
             RowBox[{"[", 
              RowBox[{"solnIdxs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Theta]", "\[Rule]", "\[Theta]v"}], ",", 
             RowBox[{"n", "\[Rule]", "nl"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"QFlap", "=", 
          RowBox[{"Q", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"2", "*", 
             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "*", "\[Alpha]"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"eaxis", "=", 
          RowBox[{"QFlap", ".", "e1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"refTri", "=", 
          RowBox[{"rotatePts", "[", 
           RowBox[{
            RowBox[{"rotatePts", "[", 
             RowBox[{"refTriA", ",", 
              RowBox[{"Q", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
                RowBox[{
                 RowBox[{"\[Pi]", "/", "2"}], "-", "\[Theta]v"}]}], "]"}]}], 
             "]"}], ",", "QFlap"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tri", "=", 
          RowBox[{"rotatePts", "[", 
           RowBox[{"refTri", ",", 
            RowBox[{"Q", "[", 
             RowBox[{"eaxis", ",", "\[Rho]v"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ret", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ret", ",", 
            RowBox[{"Triangle", "[", "tri", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"nvec", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"tri", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "\[Cross]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"nvec", "=", 
          RowBox[{"nvec", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"nvec", ".", "nvec"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ret", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ret", ",", 
            RowBox[{"Triangle", "[", 
             RowBox[{"reflPts", "[", 
              RowBox[{"tri", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "nvec"}], 
              "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "ret"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
