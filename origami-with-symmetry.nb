Cell["\<\
If you really wanted to get crazy, you could probably wrap the above example \
in a loop. I think a more targeted approach would be to look at the phase \
diagrams, pick out different parameter sets that look interesting, and \
generate stable states for that parameter set.\
\>", "Text",
 CellChangeTimes->{{3.82178650980195*^9, 
  3.8217865531406813`*^9}},ExpressionUUID->"6ec9bfff-efc1-4aac-bfe6-\
f55a7918f6f5"],

Cell["\<\
Below is an example of how I usually create a comma delimited file of stable \
states. These CSV files were what I used to make the modern art phase \
diagrams
The example file is formatted as follows:
\t\[Theta]0, r, NStable, IsBranch1Stable, IsBranch2Stable, ..., \
\[Theta]Stab1, \[Theta]Stab2, ..., UStab1, UStab2, ..., \[Delta]1, \[Delta]2, \
...
\t
\twhere
\t\[Theta]0 \t\t\t\tis the polar angle of the stress free configuration
\tr \t\t\t\tis the crease stiffness ratio
\tNStable\t\t\tis the total  number of stable states
\tIsBranch1Stable\tis 0 if the branch does not have a stable state, 1 if it \
does
\t...
\t\[Theta]Stab1\t\t\tis the polar angle of the stable state on branch 1 (if \
it exists)
\t...
\tUStab1\t\t\tis the energy of the stable state on branch 1 (if it exists)\
\>", "Text",
 CellChangeTimes->{{3.821784429166102*^9, 3.8217847219083567`*^9}, {
  3.8217853256863117`*^9, 
  3.821785342280298*^9}},ExpressionUUID->"c024e12f-0080-4948-8e20-\
f5f87a184ce9"],

Cell["\<\
I left this commented out because it is monstrously slow; if you want to \
create a database of stable states like this, expect it to take at least 2 \
min to several hours\
\>", "Text",
 CellChangeTimes->{{3.8217860484182577`*^9, 
  3.821786108174285*^9}},ExpressionUUID->"654b0688-e0eb-4182-bd50-\
044a9790e934"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Eta]", "=", "0.01"}], ";", "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "q", "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"tps", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]0", ",", "\[Nu]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]0", ",", "0", ",", 
          RowBox[{"3", "*", 
           RowBox[{"\[Pi]", "/", "4"}]}], ",", 
          RowBox[{"\[Pi]", "/", "128"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", 
          RowBox[{"-", "2"}], ",", "2", ",", "0.05"}], "}"}]}], "]"}], "]"}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<D4_degeneracy.csv\>\"", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Catenate", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"tps", "[", 
              RowBox[{"[", "q", "]"}], "]"}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"tps", "[", 
                RowBox[{"[", 
                 RowBox[{"q", "+", "1"}], "]"}], "]"}], ")"}]}]}], "}"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"StabCountFlat", "[", "\[IndentingNewLine]", 
            RowBox[{
            "EightFoldCases", ",", "\[IndentingNewLine]", "EightFoldWeights", 
             ",", "\[IndentingNewLine]", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"tps", "[", 
                RowBox[{"[", 
                 RowBox[{"q", "+", "1"}], "]"}], "]"}], ")"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"tps", "[", 
              RowBox[{"[", "q", "]"}], "]"}], ",", "\[IndentingNewLine]", 
             "\[Eta]"}], "\[IndentingNewLine]", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "\[Eta]", "}"}]}], "\[IndentingNewLine]", "}"}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"q", ",", "1", ",", 
          RowBox[{"Length", "[", "tps", "]"}], ",", "2"}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "\[LessEqual]", 
       RowBox[{"Length", "[", "tps", "]"}]}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"k", "+", "2"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"result", " ", "=", " ", 
        RowBox[{"StabCountFlat", "[", "\[IndentingNewLine]", 
         RowBox[{
         "EightFoldCases", ",", "\[IndentingNewLine]", "EightFoldWeights", ",",
           "\[IndentingNewLine]", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"tps", "[", 
             RowBox[{"[", 
              RowBox[{"q", "+", "1"}], "]"}], "]"}], ")"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tps", "[", 
           RowBox[{"[", "q", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          "\[Eta]"}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nB", "=", 
        RowBox[{"Length", "[", "EightFoldCases", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "0"}], ",", 
         RowBox[{"k", "\[LessEqual]", "1"}], ",", 
         RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", "nB"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"result", "[", "stabFlags", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", 
                   RowBox[{"k", "*", "nB"}]}], "]"}], "]"}], "\[Equal]", 
                "1"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{"i", "+", 
                    RowBox[{"k", "*", "nB"}]}], "]"}], 
                  "<>", "\"\<: True\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Export", "[", 
                 RowBox[{
                  RowBox[{"RootFileName", "<>", 
                   RowBox[{"ToString", "[", 
                    RowBox[{"i", "+", 
                    RowBox[{"k", "*", "nB"}]}], "]"}], "<>", "\"\<.stl\>\""}],
                   ",", 
                  RowBox[{"Graphics3D", "[", 
                   RowBox[{
                    RowBox[{"ASymmWaterbomb", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"result", "[", "\[Theta]Stabs", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", 
                    RowBox[{"k", "*", "nB"}]}], "]"}], "]"}], ",", 
                    RowBox[{"EightFoldCases", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]}], "]"}]}],
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
