Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "StabCountUnconstrained", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"StabCountUnconstrained", "[", 
   RowBox[{
   "cases_", ",", "weights_", ",", "rk_", ",", "\[Theta]0_", ",", "\[Eta]_", ",", 
    RowBox[{"configTol_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "2"}], ")"}]}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", "k", ",", "count", ",", "flags", ",", "\[Phi]Stars", ",", 
      "UStars", ",", "\[Eta]Tests", ",", "casejk", ",", "igs", ",", "lbs", ",",
       "ubs", ",", "nL", ",", "dUL", ",", "rootL", ",", "UFlat", ",", "UStar",
       ",", "\[Eta]Testjk", ",", "ucMinjk", ",", "minConfigs", ",", 
      "minConfigjk", ",", "unique", ",", "m", ",", "\[Phi]0s", ",", "ks", ",",
       "origamis"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"igs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"7", "*", 
         RowBox[{"\[Pi]", "/", "16"}]}], ",", 
        RowBox[{"9", "*", 
         RowBox[{"\[Pi]", "/", "16"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lbs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ubs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "2"}], ",", "\[Pi]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"flags", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]Stars", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"UStars", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Eta]Tests", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"minConfigs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"origamis", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nL", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Length", "[", 
        RowBox[{"cases", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"UFlat", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"UExprAsymm", "[", 
         RowBox[{
          RowBox[{"cases", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "rk", ",", "\[Theta]0"}], 
         "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", "\[Rule]", 
           RowBox[{"\[Pi]", "/", "2"}]}], ",", 
          RowBox[{"n", "\[Rule]", "nL"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]0s", "=", 
      RowBox[{"\[Phi]0sSymmN", "[", 
       RowBox[{"\[Theta]0", ",", "nL"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ks", "=", 
      RowBox[{"rToks", "[", 
       RowBox[{"rk", ",", "nL"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Theta]0", "\[NotEqual]", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", "=", "0"}], ",", 
          RowBox[{"k", "\[LessEqual]", "1"}], ",", 
          RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[LessEqual]", 
              RowBox[{"Length", "[", "cases", "]"}]}], ",", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"casejk", "=", 
               RowBox[{
                RowBox[{"cases", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "+", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"2", "*", "k"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Length", "[", 
                    RowBox[{"cases", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], "}"}]}], "]"}]}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", "casejk", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dUL", "=", 
               RowBox[{"dUAsymmExpr", "[", 
                RowBox[{"casejk", ",", "rk", ",", "\[Theta]0"}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Quiet", "[", 
               RowBox[{"rootL", "=", 
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{"dUL", "\[Equal]", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"\[Theta]", ",", 
                    RowBox[{"igs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"lbs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"ubs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
                "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"rootL", "=", 
                 RowBox[{"FindRoot", "[", 
                  RowBox[{
                   RowBox[{"dUL", "\[Equal]", "0"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[Theta]", ",", 
                    RowBox[{"lbs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"ubs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
                   RowBox[{"Method", "\[Rule]", "\"\<Brent\>\""}]}], "]"}]}], 
                ";"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{
              "Print", "[", "\"\<Unconstrained minimization...\>\"", "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"Timing", "[", 
                RowBox[{
                 RowBox[{"ucMinjk", "=", 
                  RowBox[{"OrigamiMin", "[", 
                   RowBox[{
                    RowBox[{"bsSymm", "[", "nL", "]"}], ",", 
                    RowBox[{"rToks", "[", 
                    RowBox[{"rk", ",", "nL"}], "]"}], ",", 
                    RowBox[{"\[Phi]0sSymmN", "[", 
                    RowBox[{"\[Theta]0", ",", "nL"}], "]"}], ",", 
                    RowBox[{"\[Phi]sSymmN", "[", 
                    RowBox[{
                    RowBox[{"cases", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"\[Theta]", "/.", "rootL"}]}], "]"}], ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"(", 
                    RowBox[{"-", "2"}], ")"}]}], ",", "10000", ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"(", 
                    RowBox[{"-", "7"}], ")"}]}], ",", "10001", ",", 
                    "RK4FoldStep"}], "]"}]}], ";"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"minConfigjk", "=", 
               RowBox[{"Last", "[", 
                RowBox[{"ucMinjk", "[", "foldAngleSnapShots", "]"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"unique", "=", "True"}], ";", "\[IndentingNewLine]", 
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"m", "=", "1"}], ",", 
                RowBox[{"m", "\[LessEqual]", 
                 RowBox[{"Length", "[", "minConfigs", "]"}]}], ",", 
                RowBox[{"m", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"minConfigs", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "-", "minConfigjk"}], 
                    "]"}], "\[LessEqual]", "configTol"}], ",", 
                  RowBox[{
                   RowBox[{"unique", "=", "False"}], ";", 
                   RowBox[{"Break", "[", "]"}]}]}], "]"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"UStar", "=", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"ks", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "/", "2"}], "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"minConfigjk", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "-", 
                    RowBox[{"\[Phi]0s", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}], ")"}], "^", "2"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"m", ",", "1", ",", 
                   RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"\[Eta]Testjk", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"UFlat", "-", "UStar"}], ")"}], "/", "UFlat"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"unique", "&&", 
                 RowBox[{"\[Eta]Testjk", "\[GreaterEqual]", "\[Eta]"}]}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"minConfigs", ",", "minConfigjk"}], "]"}], ";", " ",
                  "\[IndentingNewLine]", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"origamis", ",", 
                   RowBox[{"Last", "[", 
                    RowBox[{"ucMinjk", "[", "origamiGraphics", "]"}], "]"}]}],
                   "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"count", "+=", 
                  RowBox[{"weights", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"flags", ",", 
                RowBox[{"If", "[", 
