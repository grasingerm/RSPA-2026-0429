Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "OrigamiMin", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OrigamiMin", "[", 
   RowBox[{
   "bs_", ",", "ks_", ",", "\[Phi]0s_", ",", "\[Phi]sInit_", ",", 
    "\[Epsilon]_", ",", "maxSteps_", ",", "gradUTol_", ",", "snapshotFreq_", ",", 
    RowBox[{"foldStepper_", ":", "EulerFoldStep"}], ",", 
    RowBox[{"regTol_", ":", "0"}], ",", 
    RowBox[{"regMethod_", ":", "Automatic"}], ",", 
    RowBox[{"regMaxIteractions_", ":", "100"}], ",", 
    RowBox[{"updateFreq_", ":", "30"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "step", ",", "\[Phi]ss", ",", "\[Phi]s", ",", "loopMapResidualNorms", ",",
       "origamis", ",", "admisSpaces", ",", "gradUProjs", ",", "aSpace", ",", 
      "RNorm", ",", "mins", ",", "cs", ",", "gradUProj", ",", "resLocal", ",",
       "regFlags", ",", "start", ",", "lastUpdate", ",", "now"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]s", "=", "\[Phi]sInit"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]ss", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"loopMapResidualNorms", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"origamis", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"admisSpaces", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"regFlags", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gradUProjs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"start", "=", 
      RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lastUpdate", "=", "start"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"step", "=", "1"}], ",", 
       RowBox[{"step", "\[LessEqual]", "maxSteps"}], ",", 
       RowBox[{"step", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Phi]s", "=", 
         RowBox[{"foldStepper", "[", 
          RowBox[{
          "bs", ",", "ks", ",", "\[Phi]0s", ",", "\[Phi]s", ",", 
           "\[Epsilon]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"aSpace", "=", 
         RowBox[{"admisSpace", "[", 
          RowBox[{"bs", ",", "\[Phi]s"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"RNorm", "=", 
         RowBox[{"RVertexLoopMap", "[", 
          RowBox[{"bs", ",", "\[Phi]s"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"regTol", "\[NotEqual]", "0"}], "&&", 
           RowBox[{"RNorm", ">", "regTol"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"roots", "=", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"vertexLoopMap", "[", 
                 RowBox[{"\[Alpha]s", ",", 
                  RowBox[{"Array", "[", 
                   RowBox[{"\[Phi]", ",", 
                    RowBox[{"Length", "[", "\[Phi]s", "]"}]}], "]"}]}], "]"}],
                 "\[Equal]", 
                RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\[Phi]", "[", "i", "]"}], ",", 
                   RowBox[{"\[Phi]s", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "[", "\[Phi]s", "]"}]}], "}"}]}], 
                "]"}]}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"mins", "=", 
            RowBox[{"FindMinimum", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"resLocal", "=", 
                RowBox[{
                 RowBox[{"vertexLoopMap", "[", 
                  RowBox[{"bs", ",", 
                   RowBox[{"Array", "[", 
                    RowBox[{"\[Phi]", ",", 
                    RowBox[{"Length", "[", "\[Phi]s", "]"}]}], "]"}]}], "]"}],
                  "-", 
                 RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Tr", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", "resLocal", "]"}], ".", 
                 "resLocal"}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", "i", "]"}], ",", 
                  RowBox[{"\[Phi]s", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", 
                  RowBox[{"Length", "[", "\[Phi]s", "]"}]}], "}"}]}], "]"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"Method", "\[Rule]", "regMethod"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"MaxIterations", "\[Rule]", "regMaxIteractions"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[Phi]s", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"mins", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "RNorm"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Array", "[", 
                 RowBox[{"\[Phi]", ",", 
                  RowBox[{"Length", "[", "\[Phi]s", "]"}]}], "]"}], ")"}], "/.", 
               RowBox[{"mins", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[Phi]s"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"regFlags", ",", 
             RowBox[{
              RowBox[{"mins", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "RNorm"}]}], 
            "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gradUProj", "=", 
         RowBox[{"-", 
          RowBox[{"infFold", "[", 
           RowBox[{"aSpace", ",", 
            RowBox[{"gradU", "[", 
             RowBox[{"ks", ",", "\[Phi]0s", ",", "\[Phi]s"}], "]"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"step", ",", "snapshotFreq"}], "]"}], "\[Equal]", "0"}], 
           "||", 
           RowBox[{
            RowBox[{"Norm", "[", "gradUProj", "]"}], "\[LessEqual]", 
            "gradUTol"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Phi]ss", ",", "\[Phi]s"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"loopMapResidualNorms", ",", "RNorm"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"admisSpaces", ",", "aSpace"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cs", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"CMatrix", "[", 
              RowBox[{"bs", ",", "\[Phi]s"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"origamis", ",", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{
               RowBox[{"Catenate", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"OrigamiVertex", "[", 
                   RowBox[{"bs", ",", "\[Phi]s"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Red", ",", "Thick", ",", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Arrow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
                    RowBox[{"cs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "[", "cs", "]"}]}], "}"}]}], "]"}]}], 
                   "}"}]}], "}"}], "]"}], ",", 
               RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"gradUProjs", ",", "gradUProj"}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", "gradUProj", "]"}], "\[LessEqual]", 
           "gradUTol"}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"now", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"now", "-", "lastUpdate"}], "\[GreaterEqual]", 
           "updateFreq"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Time elasped: \>\"", ",", " ", 
             RowBox[{"now", "-", "start"}], ",", " ", "\"\<, Completed: \>\"",
              ",", " ", "step", ",", " ", "\"\</\>\"", ",", " ", "maxSteps", ",",
              " ", "\"\<, |ProjgradU|: \>\"", ",", 
             RowBox[{"Norm", "[", "gradUProj", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"lastUpdate", "=", "now"}]}]}], "\[IndentingNewLine]", 
         "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"foldAngleSnapShots", "\[Rule]", "\[Phi]ss"}], ",", 
       RowBox[{"compatResidualNorms", "\[Rule]", "loopMapResidualNorms"}], ",", 
       RowBox[{"origamiGraphics", "\[Rule]", "origamis"}], ",", 
       RowBox[{"adSpaces", "\[Rule]", "admisSpaces"}], ",", 
       RowBox[{"gradUProjects", "\[Rule]", "gradUProjs"}], ",", 
       RowBox[{"regSuccesses", "\[Rule]", "regFlags"}], ",", 
       RowBox[{"numSteps", "\[Rule]", "step"}]}], "|>"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
