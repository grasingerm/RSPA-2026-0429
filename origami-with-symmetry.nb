Cell[BoxData[
 RowBox[{"ExampleEightFoldStabCount", "=", 
  RowBox[{"StabCount", "[", "\[IndentingNewLine]", 
   RowBox[{
   "EightFoldCases", ",", "\[IndentingNewLine]", "EightFoldWeights", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"10", "^", 
     RowBox[{"(", "2", ")"}]}], ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"Stiffness", " ", "ratio"}], " ", "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{"5", "*", 
     RowBox[{"\[Pi]", "/", "8"}]}], ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Polar", " ", "angle", " ", "of", " ", "stress", " ", "free", " ", 
      "configuration"}], " ", "*)"}], "\[IndentingNewLine]", "0.01"}], 
   "          ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Empirically", " ", "speaking"}], ",", " ", 
     RowBox[{
     "this", " ", "value", " ", "of", " ", "\[Delta]", " ", "seems", " ", 
      "to", " ", "work", " ", "well"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.82178535165204*^9, 3.821785417564158*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"cee960fd-e1d4-404a-a976-4cfff1e3ac62"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"numStabs", "\[Rule]", "10"}], ",", 
