          "\[Theta]v"}], "]"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"z", "=", "1"}], ",", 
      RowBox[{"z", "\[LessEqual]", 
       RowBox[{"Length", "[", "csLocal", "]"}]}], ",", 
      RowBox[{"z", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Assert", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"csLocal", "[", 
            RowBox[{"[", "z", "]"}], "]"}], ".", 
           RowBox[{"csLocal", "[", 
            RowBox[{"[", "z", "]"}], "]"}]}], "-", "1"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "3"}], ")"}]}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
