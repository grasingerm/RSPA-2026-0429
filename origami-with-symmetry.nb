Cell["\<\
The next two functions are probably the most important. Here is a description \
of the parameters
\tcases\t\ta matrix of which describes the way each flap is folded; each row \
is a \[OpenCurlyDoubleQuote]folding branch\[CloseCurlyDoubleQuote] of the \
entire origami (i.e. specifies how the origami is folding); the columns \
should be 1 or 2 and signify \t\t\t\t\t\thow each flap is being folded for \
that particular folding branch of the origami
\tweights\t\tvector of the number of configurations each branch corresponds \
to; length of `weights` should be equal to the number of rows of `cases`
\trk\t\t\tcrease stiffness ratio
\t\[Theta]0\t\t\tpolar angle of the stress free configuration
\t\[Eta]\t\t\tstable state tolerance (the energy well of the stable state \
must be this deep to be counted)
\t
Here is a description of the output:
\tnumStabs\t\tnumber of stable states
\tstabFlags\t\t\t1 if there is a stable state on that folding branch, 0 if \
there isn\[CloseCurlyQuote]t
\t\[Theta]Stabs\t\t\tpolar angle of each stable state
\tUStabs\t\t\tenergy of each stable state
\t\[Delta]s\t\t\t\tnormalized depth of energy well
\t
Note: there are twice as many \[OpenCurlyDoubleQuote]branches\
\[CloseCurlyDoubleQuote] in the output as in the input. That is because the \
output differentiates between pushing the vertex up versus pushing the vertex \
down. Thus, the first half of the output flags correspond to pushing each \
folding branch up and the second half to pushing each folding branch down. So \
if Length[cases] = N, then stableFlags[[k]] where k < N tells you whether or \
not there is a stable configuration on folding branch k when pushing the \
vertex up and stabFlags[[N+k]] tells you whether or not there is a stable \
configuration on folding branch k when pushing the vertex down.\
\>", "Text",
 CellChangeTimes->{{3.821784735976069*^9, 3.821785016677258*^9}, {
  3.8217862189130173`*^9, 
  3.821786481481275*^9}},ExpressionUUID->"c6c7dc28-8a77-449e-a87e-\
d22fabb725df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StabCount", "[", 
   RowBox[{
   "cases_", ",", "weights_", ",", "rk_", ",", "\[Theta]0_", ",", "\[Eta]_"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", "k", ",", "count", ",", "flags", ",", "\[Theta]Stars", ",", 
      "UStars", ",", "\[Eta]Tests", ",", "casejk", ",", "igs", ",", "lbs", ",",
       "ubs", ",", "nL", ",", "dUL", ",", "rootL", ",", "UFlat", ",", "UStar",
       ",", "\[Eta]Testjk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"igs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"7", "*", 
         RowBox[{"\[Pi]", "/", "16"}]}], ",", 
        RowBox[{"9", "*", 
         RowBox[{"\[Pi]", "/", "16"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lbs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ubs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "2"}], ",", "\[Pi]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"flags", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]Stars", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"UStars", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Eta]Tests", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nL", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Length", "[", 
        RowBox[{"cases", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"UFlat", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"UExprAsymm", "[", 
         RowBox[{
          RowBox[{"cases", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "rk", ",", "\[Theta]0"}], 
         "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", "\[Rule]", 
           RowBox[{"\[Pi]", "/", "2"}]}], ",", 
          RowBox[{"n", "\[Rule]", "nL"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Theta]0", "\[NotEqual]", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", "=", "0"}], ",", 
          RowBox[{"k", "\[LessEqual]", "1"}], ",", 
          RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[LessEqual]", 
              RowBox[{"Length", "[", "cases", "]"}]}], ",", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"casejk", "=", 
               RowBox[{
                RowBox[{"cases", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "+", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"2", "*", "k"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Length", "[", 
                    RowBox[{"cases", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], "}"}]}], "]"}]}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"dUL", "=", 
               RowBox[{"dUAsymmExpr", "[", 
                RowBox[{"casejk", ",", "rk", ",", "\[Theta]0"}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Quiet", "[", 
               RowBox[{"rootL", "=", 
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{"dUL", "\[Equal]", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"\[Theta]", ",", 
                    RowBox[{"igs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"lbs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"ubs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}],
                "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"rootL", "=", 
                 RowBox[{"FindRoot", "[", 
                  RowBox[{
                   RowBox[{"dUL", "\[Equal]", "0"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[Theta]", ",", 
                    RowBox[{"lbs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"ubs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
                   RowBox[{"Method", "\[Rule]", "\"\<Brent\>\""}]}], "]"}]}], 
                ";"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"UStar", "=", 
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{"UExprAsymm", "[", 
                  RowBox[{"casejk", ",", "rk", ",", "\[Theta]0"}], "]"}], "/.", 
                 RowBox[{"Catenate", "[", 
                  RowBox[{"{", 
                   RowBox[{"rootL", ",", 
                    RowBox[{"{", 
                    RowBox[{"n", "\[Rule]", "nL"}], "}"}]}], "}"}], "]"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"\[Eta]Testjk", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"UFlat", "-", "UStar"}], ")"}], "/", "UFlat"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"count", "+=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"\[Eta]Testjk", "\[GreaterEqual]", "\[Eta]"}], ",", 
                 RowBox[{"weights", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", "0"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"flags", "=", 
               RowBox[{"Append", "[", 
                RowBox[{"flags", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"\[Eta]Testjk", "\[GreaterEqual]", "\[Eta]"}], ",",
                    "1", ",", "0"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"\[Theta]Stars", "=", 
               RowBox[{"Append", "[", 
                RowBox[{"\[Theta]Stars", ",", 
                 RowBox[{"\[Theta]", "/.", "rootL"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"UStars", "=", 
               RowBox[{"Append", "[", 
                RowBox[{"UStars", ",", "UStar"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"\[Eta]Tests", "=", 
               RowBox[{"Append", "[", 
                RowBox[{"\[Eta]Tests", ",", "\[Eta]Testjk"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"numStabs", "->", "count"}], ",", 
          RowBox[{"stabFlags", "\[Rule]", "flags"}], ",", 
          RowBox[{"\[Theta]Stabs", "\[Rule]", "\[Theta]Stars"}], ",", 
          RowBox[{"UStabs", "\[Rule]", "UStars"}], ",", 
          RowBox[{"\[Delta]s", "\[Rule]", "\[Eta]Tests"}]}], "|>"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"numStabs", "\[Rule]", "1"}], ",", 
         RowBox[{"stabFlags", "\[Rule]", 
          RowBox[{"Table", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"2", "*", 
              RowBox[{"Length", "[", "cases", "]"}]}], "}"}]}], "]"}]}], ",", 
         
         RowBox[{"\[Theta]Stabs", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", "*", 
              RowBox[{"Length", "[", "cases", "]"}]}], "}"}]}], "]"}]}], ",", 
         
         RowBox[{"UStabs", "\[Rule]", 
          RowBox[{"Table", "[", 
           RowBox[{"UFlat", ",", 
            RowBox[{"{", 
             RowBox[{"2", "*", 
              RowBox[{"Length", "[", "cases", "]"}]}], "}"}]}], "]"}]}], ",", 
         
         RowBox[{"\[Delta]s", "\[Rule]", 
          RowBox[{"Table", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"2", "*", 
              RowBox[{"Length", "[", "cases", "]"}]}], "}"}]}], "]"}]}]}], 
        "|>"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.816545588505465*^9, {3.816545621551435*^9, 3.816545659427826*^9}, 
   3.81655589641875*^9, {3.8165566431778603`*^9, 3.816556646393571*^9}, {
