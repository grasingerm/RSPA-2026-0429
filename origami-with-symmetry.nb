Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bsSymm", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"j", "*", "2", "*", 
         RowBox[{"\[Pi]", "/", "n"}]}], "]"}], ",", 
       RowBox[{"Sin", "[", 
        RowBox[{"j", "*", "2", "*", 
         RowBox[{"\[Pi]", "/", "n"}]}], "]"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"foldMap", "[", 
    RowBox[{"bs_", ",", "\[Phi]s_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"j", "\[Equal]", "1"}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
     RowBox[{"MatrixProduct", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Q", "[", 
         RowBox[{
          RowBox[{"bs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"\[Phi]s", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vertexLoopMap", "[", 
    RowBox[{"bs_", ",", "\[Phi]s_"}], "]"}], ":=", 
   RowBox[{"foldMap", "[", 
    RowBox[{"bs", ",", "\[Phi]s", ",", 
     RowBox[{
      RowBox[{"Length", "[", "bs", "]"}], "+", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]sSymm", "[", "\[Rho]Idxs_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "ret", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ret", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]s", "[", 
           RowBox[{"[", 
            RowBox[{"\[Rho]Idxs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "+", 
          RowBox[{"\[Rho]s", "[", 
           RowBox[{"[", 
            RowBox[{"\[Rho]Idxs", "[", 
             RowBox[{"[", 
              RowBox[{"Length", "[", "\[Rho]Idxs", "]"}], "]"}], "]"}], "]"}],
            "]"}]}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"\[Rho]Idxs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "2"}], "]"}], "\[Equal]", 
            "1"}], ",", 
           RowBox[{"-", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"2", "*", "\[Theta]"}], "-", "\[Pi]"}], "]"}]}], ",", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"2", "*", "\[Theta]"}], "-", "\[Pi]"}], "]"}]}], "]"}]}],
         "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "2"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "[", "\[Rho]Idxs", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"ret", ",", 
           RowBox[{
            RowBox[{"\[Rho]s", "[", 
             RowBox[{"[", 
              RowBox[{"\[Rho]Idxs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "+", 
            RowBox[{"\[Rho]s", "[", 
             RowBox[{"[", 
              RowBox[{"\[Rho]Idxs", "[", 
               RowBox[{"[", 
                RowBox[{"i", "-", "1"}], "]"}], "]"}], "]"}], "]"}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"ret", ",", 
           RowBox[{"If", "[", 
