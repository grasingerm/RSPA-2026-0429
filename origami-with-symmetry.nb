Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", "r_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        RowBox[{"r", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", 
       RowBox[{"r", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{"r", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"r", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"r", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"32638a10-35e0-486b-a727-dd55b5d6eff8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Q", "[", 
    RowBox[{"rvec_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "*", 
     RowBox[{"rvec", "\[TensorProduct]", "rvec"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
     RowBox[{"A", "[", "rvec", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.816434555663805*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"4f14106a-760b-4042-bcb4-528e38d0ae3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"transX", "[", 
    RowBox[{"points_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", "=", "points"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "[", "x", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", "c"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "x"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.816434159702943*^9, 3.816434160668063*^9}, {
  3.816434562789445*^9, 3.816434575740144*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"3a05a8ff-0b84-4b76-89c2-e2745d482e7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]toX", "[", "\[Alpha]_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"0", "\[LessEqual]", "\[Alpha]", "\[LessEqual]", 
       RowBox[{"\[Pi]", "/", "4"}]}], "||", 
      RowBox[{
       RowBox[{"7", "*", 
        RowBox[{"\[Pi]", "/", "4"}]}], "<", "\[Alpha]", "\[LessEqual]", 
       RowBox[{"2", "*", "\[Pi]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1.0", ",", 
       RowBox[{"Tan", "[", "\[Alpha]", "]"}], ",", "0.0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Pi]", "/", "4"}], "<", "\[Alpha]", "\[LessEqual]", 
        RowBox[{"3", "*", 
         RowBox[{"\[Pi]", "/", "4"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cot", "[", "\[Alpha]", "]"}], ",", "1.0", ",", "0.0"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", "*", 
           RowBox[{"\[Pi]", "/", "4"}]}], "<", "\[Alpha]", "\[LessEqual]", 
          RowBox[{"5", "*", 
           RowBox[{"\[Pi]", "/", "4"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.0"}], ",", 
           RowBox[{"-", 
            RowBox[{"Tan", "[", "\[Alpha]", "]"}]}], ",", "0.0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cot", "[", "\[Alpha]", "]"}]}], ",", 
           RowBox[{"-", "1.0"}], ",", "0.0"}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"5d49ccb6-50e6-4f1d-a159-acdc1a19d7a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reflPt", "[", 
    RowBox[{"p_", ",", "q_", ",", "u_"}], "]"}], ":=", 
   RowBox[{"p", "-", 
    RowBox[{"2", "*", "u", "*", 
     RowBox[{"Dot", "[", 
      RowBox[{
       RowBox[{"p", "-", "q"}], ",", "u"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"8b64e6b7-e84a-40e0-8512-73788d451d2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reflPts", "[", 
    RowBox[{"X_", ",", "q_", ",", "u_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Y", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "[", "X", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Y", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"Y", ",", 
            RowBox[{"reflPt", "[", 
             RowBox[{
              RowBox[{"X", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "q", ",", "u"}], "]"}]}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "Y"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.816434613801446*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"3d16a770-08b8-4770-b6e1-ad3b8b12a271"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rotatePts", "[", 
    RowBox[{"X_", ",", "QQ_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Y", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "[", "X", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Y", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"Y", ",", 
            RowBox[{"QQ", ".", 
             RowBox[{"X", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "Y"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.8164346194277287`*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"87284cac-6ff3-410a-af7b-e53143f90edc"],

