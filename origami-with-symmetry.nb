Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StabCountFlat", "[", 
    RowBox[{
    "cases_", ",", "weights_", ",", "rk_", ",", "\[Theta]0_", ",", 
     "\[Eta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "results", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"results", "=", 
       RowBox[{"StabCount", "[", 
        RowBox[{
        "cases", ",", "weights", ",", "rk", ",", "\[Theta]0", ",", "\[Eta]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Catenate", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"results", "[", "numStabs", "]"}], "}"}], ",", 
         RowBox[{"results", "[", "stabFlags", "]"}], ",", 
         RowBox[{"results", "[", "\[Theta]Stabs", "]"}], ",", 
         RowBox[{"results", "[", "UStabs", "]"}], ",", 
         RowBox[{"results", "[", "\[Delta]s", "]"}]}], "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"a88c50f8-8a53-42dc-9b17-64496e816e70"],

