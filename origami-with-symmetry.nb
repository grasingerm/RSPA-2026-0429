                  "1", ",", "0"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"\[Phi]Stars", ",", "minConfigjk"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"UStars", ",", "UStar"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"\[Eta]Tests", ",", "\[Eta]Testjk"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"numStabs", "->", "count"}], ",", 
          RowBox[{"stabFlags", "\[Rule]", "flags"}], ",", 
          RowBox[{"\[Phi]sStabs", "\[Rule]", "\[Phi]Stars"}], ",", 
          RowBox[{"UStabs", "\[Rule]", "UStars"}], ",", 
          RowBox[{"\[Delta]s", "\[Rule]", "\[Eta]Tests"}], ",", 
          RowBox[{"origamiGraphics", "\[Rule]", "origamis"}]}], "|>"}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"numStabs", "\[Rule]", "1"}], ",", 
